<Window x:Class="Clicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АААААААА" Height="450" Width="800">
    <Grid>
        <Canvas x:Name="GameCanvas" Background="White"
                MouseLeftButtonDown="GameCanvas_MouseLeftButtonDown"/>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                    HorizontalAlignment="Left" Margin="10">
            <TextBlock Text="Очки: " FontSize="16"/>
            <TextBlock x:Name="ScoreText" Text="0" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="   Время: " FontSize="16" Margin="20,0,0,0"/>
            <TextBlock x:Name="TimeText" Text="0" FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <Button x:Name="StartButton" Content="Старт"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Width="120" Height="40" Margin="10"
                Click="StartButton_Click"/>
    </Grid>
</Window>